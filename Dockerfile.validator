FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup --system eaims && adduser --system --ingroup eaims eaims

# Copy package metadata and canonical data before installation so a wheel/install
# can include the structured specification in share/eaims/.
COPY pyproject.toml README.md /app/
COPY src /app/src
COPY spec /app/spec
COPY schemas /app/schemas
COPY tests/catalog.yaml /app/tests/catalog.yaml

RUN pip install --no-cache-dir .

USER eaims

ENTRYPOINT ["eaims-validate"]
