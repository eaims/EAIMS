{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eaims.org/schemas/requirements.schema.json",
  "title": "EAIMS Requirements Catalog",
  "type": "object",
  "required": [
    "spec_version",
    "status",
    "requirements"
  ],
  "properties": {
    "spec_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "requirement_count": {
      "type": "integer",
      "minimum": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "title",
          "normative_level",
          "statement",
          "criticality",
          "machine_verifiability"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^EAIMS-[A-Z0-9]+-[0-9]{3}$"
          },
          "capability_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{3}-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "normative_level": {
            "enum": [
              "SHALL",
              "SHALL_NOT",
              "SHOULD",
              "SHOULD_NOT",
              "MAY"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 12
          },
          "criticality": {
            "enum": [
              "normal",
              "material",
              "critical"
            ]
          },
          "machine_verifiability": {
            "enum": [
              "MV1",
              "MV2",
              "MV3",
              "MV4"
            ]
          },
          "status": {
            "type": "string"
          },
          "introduced_in": {
            "type": "string"
          },
          "cross_cutting": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}